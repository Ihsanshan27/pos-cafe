generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  outletId     String?
  outlet       Outlet?        @relation(fields: [outletId], references: [id], onDelete: SetNull)
  role         Role          @default(CASHIER)
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  shifts       Shift[]
  purchaseOrders PurchaseOrder[]
}

model OtpVerification {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  type      String   // 'REGISTER' | 'FORGOT_PASSWORD'
  createdAt DateTime @default(now())

  @@index([email])
}

enum Role {
  OWNER
  MANAGER
  CASHIER
  BARISTA
}

model Ingredient {
  id            String       @id @default(uuid())
  name          String
  unit          String       // e.g., gram, ml, pcs
  costPerUnit   Decimal      // Cost per unit for dynamic HPP calculation
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  recipes       RecipeItem[]
  inventoryLogs InventoryLog[]
  purchaseOrderItems PurchaseOrderItem[]
  outletStocks  OutletIngredient[]
}

model Outlet {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  address      String?
  phone        String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  users        User[]
  shifts       Shift[]
  transactions Transaction[]
  expenses     Expense[]
  purchaseOrders PurchaseOrder[]
  tableQRCodes TableQRCode[]
  outletStocks OutletIngredient[]
  inventoryLogs InventoryLog[]
  outletMenus  OutletMenu[]
}

model Category {
  id                 String   @id @default(uuid())
  name               String   @unique
  isStickerPrintable Boolean  @default(true)
  menus              Menu[]
}

model Menu {
  id            String       @id @default(uuid())
  name          String
  description   String?
  sellingPrice  Decimal
  imageUrl      String?
  categoryId    String?
  category      Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  ingredients   RecipeItem[]
  transactions  TransactionItem[]
  outletMenus   OutletMenu[]
  modifierGroups ModifierGroup[]
}

model RecipeItem {
  id            String     @id @default(uuid())
  quantity      Float      // Amount needed for 1 portion
  menuId        String
  menu          Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  ingredientId  String
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([menuId, ingredientId])
}

model Expense {
  id          String   @id @default(uuid())
  description String
  amount      Decimal
  outletId    String?
  outlet      Outlet?  @relation(fields: [outletId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum PaymentMethod {
  CASH
  QRIS
  DEBIT
  EWALLET
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

model Discount {
  id        String   @id @default(uuid())
  code      String   @unique
  type      String   // 'PERCENTAGE' or 'FIXED'
  value     Decimal
  isActive  Boolean  @default(true)
}

model Shift {
  id                  String        @id @default(uuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id])
  outletId            String?
  outlet              Outlet?       @relation(fields: [outletId], references: [id], onDelete: SetNull)
  startTime           DateTime      @default(now())
  endTime             DateTime?
  startingCash        Decimal
  actualEndingCash    Decimal?
  expectedEndingCash  Decimal?      // Calculated: startingCash + CASH sales - expenses
  cashDifference      Decimal?      // actualEndingCash - expectedEndingCash
  totalCashSales      Decimal?      // Total revenue from CASH transactions
  totalNonCashSales   Decimal?      // Total revenue from non-CASH transactions
  totalExpenses       Decimal?      // Total expenses during shift
  transactionCount    Int?          // Number of completed transactions
  notes               String?       // Cashier closing notes
  status              String        @default("OPEN") // 'OPEN' or 'CLOSED'
  transactions        Transaction[]
}

model Transaction {
  id             String            @id @default(uuid())
  orderNumber    String?           @unique
  source         TransactionSource @default(POS)
  totalAmount    Decimal
  paymentMethod  PaymentMethod     @default(CASH)
  status         TransactionStatus @default(COMPLETED)
  orderType      OrderType         @default(DINE_IN)
  tableNumber    String?
  outletId       String?
  outlet         Outlet?           @relation(fields: [outletId], references: [id], onDelete: SetNull)
  discountAmount Decimal           @default(0)
  taxAmount      Decimal           @default(0)
  customerName   String?
  customerId     String?
  customer       Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shiftId        String?
  shift          Shift?            @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  kitchenStatus  KitchenStatus     @default(PENDING)
  items          TransactionItem[]
}

enum TransactionSource {
  POS
  PUBLIC_QR
}

enum KitchenStatus {
  PENDING
  IN_PROGRESS
  DONE
}

model TransactionItem {
  id            String      @id @default(uuid())
  quantity      Int
  priceAtSale   Decimal
  subtotal      Decimal
  notes         String?
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  menuId        String?
  menu          Menu?       @relation(fields: [menuId], references: [id], onDelete: SetNull)
  modifiers     Json?
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Setting {
  key   String @id
  value String
}

model Customer {
  id           String        @id @default(uuid())
  name         String
  phone        String?       @unique
  email        String?       @unique
  pointBalance Int           @default(0)
  tier         CustomerTier  @default(BRONZE)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
}

enum CustomerTier {
  BRONZE
  SILVER
  GOLD
}

model InventoryLog {
  id           String      @id @default(uuid())
  ingredientId String
  ingredient   Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  outletId     String?
  outlet       Outlet?     @relation(fields: [outletId], references: [id], onDelete: SetNull)
  type         LogType
  quantity     Float
  notes        String?
  createdAt    DateTime    @default(now())
  createdBy    String?
}

enum LogType {
  IN
  OUT
  SALE
  VOID
  ADJUSTMENT
}

model Supplier {
  id          String          @id @default(uuid())
  name        String
  phone       String?
  email       String?
  address     String?
  notes       String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  orderNumber  String              @unique
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  outletId     String?
  outlet       Outlet?             @relation(fields: [outletId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  status       PurchaseOrderStatus @default(DRAFT)
  notes        String?
  expectedDate DateTime?
  receivedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  items        PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredientId    String
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity        Float
  unitCost        Decimal
  receivedQuantity Float        @default(0)
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model TableQRCode {
  id          String   @id @default(uuid())
  outletId    String
  outlet      Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  code        String
  label       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([outletId, code])
}

model OutletIngredient {
  id            String     @id @default(uuid())
  outletId      String
  outlet        Outlet     @relation(fields: [outletId], references: [id], onDelete: Cascade)
  ingredientId  String
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  stockQuantity Float      @default(0)

  @@unique([outletId, ingredientId])
}

model OutletMenu {
  id            String   @id @default(uuid())
  outletId      String
  outlet        Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  menuId        String
  menu          Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  sellingPrice  Decimal
  isActive      Boolean  @default(true)

  @@unique([outletId, menuId])
}

model ModifierGroup {
  id            String            @id @default(uuid())
  name          String
  isRequired    Boolean           @default(false)
  isMultiple    Boolean           @default(false)
  options       ModifierOption[]
  menus         Menu[]
}

model ModifierOption {
  id            String         @id @default(uuid())
  name          String
  price         Decimal        @default(0)
  groupId       String
  group         ModifierGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userEmail  String?
  userName   String?
  action     String   // e.g. "UPDATE_MENU", "VOID_TRANSACTION", "RESTORE_BACKUP"
  target     String   // e.g. "Menu: Cappuccino", "Transaksi: Order #SHN..."
  details    String?  // Data lama vs baru / detail deskripsi
  ipAddress  String?
  createdAt  DateTime @default(now())
}
